#!/usr/bin/env bash
# pre-commit -- regenerate doc index + changelog INTO this commit
# Installed by: prysm-env/scripts/repo/hooks/install_hooks.sh
#
# There is no `git commit --amend` in this hook. Artifacts are staged before the
# commit object is built, so the SHA is final and git never has to rewrite it.

# -- Identity gate ----------------------------------------------------
# PRYSM_USER_ROLE is the current gate and appears once prysm setup has been
# re-run; MACHINE is the cached legacy gate. Either is sufficient, so the hook
# keeps regenerating across that transition instead of silently going quiet.
if [ "${PRYSM_USER_ROLE:-}" != "owner_dev" ] && [ "${MACHINE:-}" != "yp3rz" ]; then
	exit 0
fi

# -- Recursion guard --------------------------------------------------
[ "${PRE_COMMIT_RUNNING:-}" = "1" ] && exit 0
export PRE_COMMIT_RUNNING=1

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
GIT_DIR_REAL="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
HOOKS_LIB="${HOME}/.local/share/prysm/hooks"

# -- Concurrent-commit mutex ------------------------------------------
# Serializes regeneration across parallel sessions on one worktree. Resolved
# against the real git dir, so a submodule or worktree checkout -- where .git is
# a FILE -- gets its own lock rather than a path that cannot exist.
LOCK_DIR="$GIT_DIR_REAL/prysm-precommit.lock.d"
LOCK_WAITED=0
while ! mkdir "$LOCK_DIR" 2>/dev/null; do
	LOCK_WAITED=$((LOCK_WAITED + 1))
	if [ "$LOCK_WAITED" -gt 120 ]; then
		echo "  pre-commit: regeneration lock held >120s -- skipping regeneration." >&2
		echo "  If no other commit is running: rmdir $LOCK_DIR" >&2
		exit 0
	fi
	sleep 1
done
trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT INT TERM

INITIAL_STAGED="$(git diff --cached --name-only | sort -u)"
# -- Changelog in README.md -------------------------------------------
if [ -f "$HOOKS_LIB/update_readme_changelog.sh" ]; then
	"$HOOKS_LIB/update_readme_changelog.sh" "$REPO_ROOT" 2>/dev/null || true
fi

# -- Stage the regenerated artifacts into THIS commit -----------------
[ -f "$REPO_ROOT/README.md" ]         && git add "$REPO_ROOT/README.md"         2>/dev/null
[ -f "$REPO_ROOT/docs/doc_index.md" ] && git add "$REPO_ROOT/docs/doc_index.md" 2>/dev/null

# -- Foreign-staging detection ----------------------------------------
# This hook may add only the artifacts above. Anything else that entered the
# index during the window belongs to another process, and committing it would
# absorb work that is not part of this change.
CURRENT_STAGED="$(git diff --cached --name-only | sort -u)"
EXPECTED_STAGED="$({
	printf "%s\n" "$INITIAL_STAGED"
	echo "README.md"
	echo "docs/doc_index.md"
} | grep -v "^$" | sort -u)"

UNEXPECTED="$(comm -23 <(printf "%s\n" "$CURRENT_STAGED") <(printf "%s\n" "$EXPECTED_STAGED"))"
if [ -n "$UNEXPECTED" ]; then
	echo "" >&2
	echo "  ERROR: foreign staging detected during the pre-commit window." >&2
	echo "  Another process staged these after this commit started:" >&2
	printf "%s\n" "$UNEXPECTED" | sed "s/^/    /" >&2
	echo "" >&2
	echo "  Commit aborted rather than absorb work that is not yours." >&2
	exit 1
fi

exit 0

